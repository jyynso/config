{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/kitafr.txt",
    "color": {
      "1": "#FF1E1E"
      },
    "padding": {
      "top": 2,
      "left": 2
      }
    },

    "display": {
        "separator": "  ",
        "key": {
            "width": 7
        }
    },

    "modules": [
        "break",
        "title",
        {
            "type": "custom",
            "format": "\u001b[38;2;232;185;59m────────────────────────────\u001b[0m"
        },
        { "type": "os",       "key": "os" },
        { "type": "kernel",   "key": "kern" },
        { "type": "de",       "key": "de" },
        { "type": "shell",    "key": "sh" },
        { "type": "terminal", "key": "term" },
        { "type": "cpu",      "key": "cpu", "format": "{name}", "showPeCoreCount": false },
        { "type": "gpu",      "key": "gpu", "format": "{name}" },
        { "type": "memory",   "key": "ram" },
        { "type": "disk",     "key": "disk" },
        { "type": "uptime",   "key": "up" },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2
        },
        "break"
    ]
}
